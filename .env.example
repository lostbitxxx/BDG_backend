# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@bodonggua.npgsine.mongodb.net/?appName=BoDongGua
DB_NAME=bodongsgua

# JWT
JWT_SECRET=your-jwt-secret-key-here

# Server
PORT=3001
FRONTEND_URL=http://localhost:3000

# Redis
REDIS_URL=redis://<username>:<password>@redis-host:port

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=bodonggua-audio
AWS_REGION=ap-southeast-2

# OpenRouter (AI)
OPENROUTER_API_KEY=your-openrouter-api-key

# ElevenLabs (TTS)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_FEMALE=your-voice-id
ELEVENLABS_VOICE_MALE=your-voice-id

# iFlytek ISE (Pronunciation)
IFLYTEK_APP_ID=your-iflytek-app-id
IFLYTEK_API_KEY=your-iflytek-api-key
IFLYTEK_API_SECRET=your-iflytek-api-secret

# Python Tone Analysis Service
PYTHON_SERVICE_URL=http://localhost:8000
